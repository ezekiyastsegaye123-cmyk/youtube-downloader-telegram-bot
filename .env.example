# =========================================================
# YouTube Downloader Telegram Bot Configuration
# =========================================================

# Telegram Bot Token (Get one from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Access Control (Optional: comma-separated list of Telegram User IDs allowed to use the bot. Leave blank for public access)
ALLOWED_USERS=

# =========================================================
# Self-Hosted Local Telegram Bot API (Solution B - Up to 2GB)
# =========================================================
# Get your API ID and API HASH from https://my.telegram.org (under API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# URL to your local Telegram Bot API Server
# If using docker-compose: http://telegram-bot-api:8081/bot
# If running locally outside docker: http://localhost:8081/bot
# Leave empty if using standard Telegram cloud API (capped at 50MB)
TELEGRAM_API_URL=

# Max download file size limit in MB (Set to 2000 for 2GB local server support)
MAX_FILE_SIZE_MB=2000

# =========================================================
# Anti-Bot & Network Settings
# =========================================================
# Path to cookies.txt file for YouTube authentication (Optional, helps bypass bot blocks)
COOKIES_FILE=

# Proxy URL for yt-dlp (Optional, e.g., http://user:pass@host:port or socks5://host:port)
PROXY_URL=

# Temporary download directory
DOWNLOAD_DIR=./downloads
