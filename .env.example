# Telegram Bot Token (Get one from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Access Control (Optional: comma-separated list of Telegram User IDs allowed to use the bot. Leave blank for public access)
ALLOWED_USERS=

# Telegram Bot API URL (Optional: Set this if running a local Bot API server to support files up to 2GB)
# Example: http://localhost:8081/bot
TELEGRAM_API_URL=

# Max download file size limit in MB (Telegram default for standard bots is 50)
MAX_FILE_SIZE_MB=50

# Path to cookies.txt file for YouTube authentication (Optional, helps bypass bot blocks)
COOKIES_FILE=

# Proxy URL for yt-dlp (Optional, e.g., http://user:pass@host:port or socks5://host:port)
PROXY_URL=

# Temporary download directory
DOWNLOAD_DIR=./downloads
